{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Poly Orchestrator — AI Visibility Metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Query Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "calcs": ["last"], "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_queries_total[5m])) by (adapter)",
          "legendFormat": "{{adapter}}",
          "refId": "A"
        }
      ],
      "title": "Query Rate by Adapter (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "p95"], "displayMode": "list" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orchestrator_query_duration_seconds_bucket[5m])) by (le, adapter))",
          "legendFormat": "p95 {{adapter}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(orchestrator_query_duration_seconds_bucket[5m])) by (le, adapter))",
          "legendFormat": "p50 {{adapter}}",
          "refId": "B"
        }
      ],
      "title": "Query Latency (p50 / p95) by Adapter",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Brand Visibility",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.3 },
            { "color": "green", "value": 0.7 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [
        {
          "expr": "orchestrator_brand_mention_rate",
          "legendFormat": "{{brand}}",
          "refId": "A"
        }
      ],
      "title": "Brand Mention Rate",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": -1 },
            { "color": "yellow", "value": 0 },
            { "color": "green", "value": 0.3 }
          ]},
          "min": -1, "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "orchestrator_brand_sentiment_score",
          "legendFormat": "{{brand}}",
          "refId": "A"
        }
      ],
      "title": "Brand Sentiment Score (-1 to +1)",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "increase(orchestrator_adapter_errors_total[1h])",
          "legendFormat": "{{adapter}}",
          "refId": "A"
        }
      ],
      "title": "Adapter Errors (last 1h)",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["poly-orchestrator", "ai-visibility"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "Prometheus",
        "definition": "label_values(orchestrator_brand_mention_rate, brand)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "brand",
        "options": [],
        "query": "label_values(orchestrator_brand_mention_rate, brand)",
        "refresh": 2,
        "type": "query",
        "label": "Brand"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "UTC",
  "title": "Poly Orchestrator — AI Visibility",
  "uid": "poly-orchestrator-v1",
  "version": 1
}
