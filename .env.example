# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://poly:poly_pass@localhost:5432/poly_orchestrator
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── AI Provider API Keys (replace with real keys, never commit) ──────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Orchestrator ──────────────────────────────────────────────────────────────
# Comma-separated list of enabled adapters
ENABLED_ADAPTERS=openai,anthropic,google,perplexity,groq
ORCHESTRATOR_TIMEOUT_SECONDS=30
ORCHESTRATOR_MAX_CONCURRENCY=10

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
